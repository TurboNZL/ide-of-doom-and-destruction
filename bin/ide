#!/usr/bin/env bash
# Launcher for the portable editor.
#   ide                 open the editor in the current folder
#   ide <folder>        open the editor in a folder
#   ide setup           download the editor and install the extensions (first time only)
#   ide update          get the newest version of this tool and its extension
#   ide where           print where the editor is installed
#
# The editor lives in ./vscode next to this tool, in portable mode: all of its settings and
# extensions are in ./vscode/data, so a normal VS Code install is never touched.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# A git clone keeps the editor next to the tool; a .deb install (read-only /opt) keeps it in the user's own data folder.
if [ -n "${IDE_HOME:-}" ]; then HOME_DIR="$IDE_HOME"
elif [ -w "$ROOT" ]; then HOME_DIR="$ROOT/vscode"
else HOME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/ide-of-doom-and-destruction/vscode"; fi
DIST_DIR="$(dirname "$HOME_DIR")/dist"
REPO="TurboNZL/ide-of-doom-and-destruction"
CODE="$HOME_DIR/code"
CODE_CLI="$HOME_DIR/bin/code"

say() { printf '%s\n' "$*" >&2; }
die() { say "ide: $*"; exit 1; }

arch_name() {
  case "$(uname -m)" in
    x86_64|amd64) echo linux-x64 ;;
    aarch64|arm64) echo linux-arm64 ;;
    *) die "unsupported CPU: $(uname -m)" ;;
  esac
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required. Install it and try again."; }

# Runs a script with node if there is one, otherwise with the editor's own node.
run_node() {
  if command -v node >/dev/null 2>&1; then node "$@"
  else ELECTRON_RUN_AS_NODE=1 "$CODE" "$@"; fi
}

download_editor() {
  need curl; need tar
  local url="${IDE_VSCODE_URL:-https://update.code.visualstudio.com/latest/$(arch_name)/stable}"
  local tmp; tmp="$(mktemp -d)"
  say "Downloading the editor ($url)..."
  curl -fL --progress-bar -o "$tmp/code.tar.gz" "$url"
  rm -rf "$HOME_DIR.new"; mkdir -p "$HOME_DIR.new"
  tar -xzf "$tmp/code.tar.gz" -C "$HOME_DIR.new" --strip-components=1
  rm -rf "$tmp"
  # Keep the existing settings and extensions when the editor itself is replaced.
  if [ -d "$HOME_DIR/data" ]; then mv "$HOME_DIR/data" "$HOME_DIR.new/data"; fi
  rm -rf "$HOME_DIR"; mv "$HOME_DIR.new" "$HOME_DIR"
  mkdir -p "$HOME_DIR/data/user-data/User" "$HOME_DIR/data/extensions"   # this folder is what makes it portable
}

install_extensions() {
  local vsix="$DIST_DIR/ide-of-doom-and-destruction.vsix"
  say "Building the extension..."
  mkdir -p "$DIST_DIR"
  run_node "$ROOT/scripts/pack-vsix.js" "$vsix" >&2
  "$CODE_CLI" --install-extension "$vsix" --force >&2
  while read -r ext; do
    [ -z "$ext" ] && continue
    case "$ext" in \#*) continue ;; esac
    "$CODE_CLI" --install-extension "$ext" >&2 || say "Could not install $ext (you can add it later from the Extensions view)."
  done < "$ROOT/config/extensions.txt"
  tool_version > "$HOME_DIR/data/.extension-version"
  migrate_settings
}

# Earlier versions wrote two git settings that made the editor scan parent folders and fetch in the background.
migrate_settings() {
  local f="$HOME_DIR/data/user-data/User/settings.json"
  [ -f "$f" ] || return 0
  sed -i -e 's/"git.openRepositoryInParentFolders": "always"/"git.openRepositoryInParentFolders": "never"/' \
         -e 's/"git.autofetch": true/"git.autofetch": false/' "$f"
}

# The version of the tool this launcher belongs to (0.0.0 for a plain checkout).
tool_version() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/extension/package.json" | head -1
}

# After a .deb update the tool changed but the extension inside the editor is the old one: install the new one.
sync_extension() {
  [ "$(tool_version)" = "$(cat "$HOME_DIR/data/.extension-version" 2>/dev/null || true)" ] && return 0
  say "Updating the editor's extension to $(tool_version)..."
  install_extensions
}

apply_settings() {
  local target="$HOME_DIR/data/user-data/User/settings.json"
  if [ ! -e "$target" ]; then cp "$ROOT/config/settings.json" "$target"; fi
}

check_tools() {
  command -v g++ >/dev/null 2>&1 || say "Note: g++ was not found. Install a compiler (Debian/Ubuntu: sudo apt install g++)."
  command -v x86_64-w64-mingw32-g++ >/dev/null 2>&1 ||
    say "Note: the Windows cross compiler was not found, so \"Package for Submission\" cannot make an .exe yet.
      Debian/Ubuntu: sudo apt install g++-mingw-w64-x86-64-posix"
}

cmd_setup() {
  if [ ! -x "$CODE" ]; then download_editor; fi
  apply_settings
  install_extensions
  check_tools
  say "Done. Start the editor with: $ROOT/bin/ide <folder>"
}

cmd_update() {
  if [ ! -w "$ROOT" ]; then
    die "This copy was installed from the .deb, which updates from the Updates window (command palette: Updates...), or with:
      curl -fLO https://github.com/$REPO/releases/latest/download/ide-of-doom-and-destruction.deb && sudo apt install ./ide-of-doom-and-destruction.deb"
  fi
  if [ -d "$ROOT/.git" ]; then
    need git
    git -C "$ROOT" pull --ff-only
  else
    need curl; need tar
    local tmp; tmp="$(mktemp -d)"
    curl -fL --progress-bar -o "$tmp/tool.tar.gz" "https://github.com/$REPO/releases/latest/download/ide-of-doom-and-destruction.tar.gz"
    tar -xzf "$tmp/tool.tar.gz" -C "$ROOT"
    rm -rf "$tmp"
  fi
  [ -x "$CODE" ] || die "The editor is not installed yet. Run: ide setup"
  install_extensions
  say "Updated. Restart the editor to use the new version."
}

case "${1:-}" in
  setup) cmd_setup ;;
  update) cmd_update ;;
  where) echo "$HOME_DIR" ;;
  -h|--help|help)
    sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *)
    if [ ! -x "$CODE" ]; then
      if [ -t 0 ]; then cmd_setup; else die "The editor is not installed yet. Run: ide setup"; fi
    fi
    sync_extension
    # From a terminal, open the current folder. From the start menu there is no terminal and the current folder is
    # the home folder, which must not be opened (the editor would watch and scan everything in it): open an empty window.
    if [ $# -eq 0 ] && [ -t 0 ]; then set -- .; fi
    exec "$CODE" "$@" ;;
esac
