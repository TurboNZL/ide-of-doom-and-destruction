{
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Default Dark Modern",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [120],
  "files.eol": "\r\n",
  "files.autoSave": "off",
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "extensions.autoUpdate": false,
  "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/.vs", "--fallback-style=Microsoft", "--header-insertion=never", "--background-index"]
}
