{
  "name": "vsproj-tools",
  "displayName": "IDE of Doom and Destruction",
  "description": "Work with Visual Studio C++ solutions (.slnx, .sln, .vcxproj) in VS Code: new Console App, Add Class, Solution Explorer, build, run and package a submission.",
  "version": "0.0.0",
  "publisher": "turbonzl",
  "license": "MIT",
  "author": "TurboNZL",
  "repository": { "type": "git", "url": "https://github.com/TurboNZL/ide-of-doom-and-destruction" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "vsproj.newProject", "title": "New Console App...", "category": "IDE of Doom" },
      { "command": "vsproj.build", "title": "Build (F7)", "category": "IDE of Doom", "icon": "$(tools)" },
      { "command": "vsproj.rebuild", "title": "Rebuild Solution", "category": "IDE of Doom" },
      { "command": "vsproj.clean", "title": "Clean Solution", "category": "IDE of Doom" },
      { "command": "vsproj.run", "title": "Run (build and run, F5)", "category": "IDE of Doom", "icon": "$(play)" },
      { "command": "vsproj.addClass", "title": "Add Class...", "category": "IDE of Doom", "icon": "$(symbol-class)" },
      { "command": "vsproj.addNewItem", "title": "Add New Item...", "category": "IDE of Doom", "icon": "$(new-file)" },
      { "command": "vsproj.addToProject", "title": "Add to Project", "category": "IDE of Doom" },
      { "command": "vsproj.removeItem", "title": "Remove from Project", "category": "IDE of Doom" },
      { "command": "vsproj.setStartupProject", "title": "Set as Startup Project", "category": "IDE of Doom" },
      { "command": "vsproj.setConfiguration", "title": "Select Configuration and Platform...", "category": "IDE of Doom" },
      { "command": "vsproj.openProjectFile", "title": "Open Project File (.vcxproj)", "category": "IDE of Doom" },
      { "command": "vsproj.refresh", "title": "Refresh Solution Explorer", "category": "IDE of Doom", "icon": "$(refresh)" },
      { "command": "vsproj.package", "title": "Package for Submission...", "category": "IDE of Doom" },
      { "command": "vsproj.checkForUpdates", "title": "Updates...", "category": "IDE of Doom" },
      { "command": "vsproj.menu", "title": "Show All Actions", "category": "IDE of Doom", "icon": "$(rocket)" },
      { "command": "vsproj.startPage", "title": "Start Page", "category": "IDE of Doom" },
      { "command": "vsproj.runWindowsBuild", "title": "Run the Windows Build in Wine", "category": "IDE of Doom" },
      { "command": "vsproj.runExeInPrefix", "title": "Run an .exe in the Wine Prefix...", "category": "IDE of Doom" },
      { "command": "vsproj.signInGitHub", "title": "Sign in to GitHub", "category": "IDE of Doom" }
    ],
    "keybindings": [
      { "command": "vsproj.run", "key": "f5", "when": "vsproj.hasSolution" },
      { "command": "vsproj.run", "key": "ctrl+f5", "when": "vsproj.hasSolution" },
      { "command": "vsproj.build", "key": "f7", "when": "vsproj.hasSolution" },
      { "command": "vsproj.build", "key": "ctrl+shift+b", "when": "vsproj.hasSolution" },
      { "command": "vsproj.addNewItem", "key": "ctrl+shift+a", "when": "vsproj.hasSolution" },
      { "command": "vsproj.addClass", "key": "shift+alt+c", "when": "vsproj.hasSolution" },
      { "command": "vsproj.newProject", "key": "ctrl+shift+n" },
      { "command": "vsprojSolution.focus", "key": "ctrl+alt+l", "when": "vsproj.hasSolution" },
      { "command": "editor.action.formatDocument", "key": "ctrl+k ctrl+d", "when": "editorTextFocus" },
      { "command": "editor.action.addCommentLine", "key": "ctrl+k ctrl+c", "when": "editorTextFocus" },
      { "command": "editor.action.removeCommentLine", "key": "ctrl+k ctrl+u", "when": "editorTextFocus" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "vsprojContainer", "title": "Solution Explorer", "icon": "media/solution.svg" }]
    },
    "views": {
      "vsprojContainer": [{ "id": "vsprojSolution", "name": "Solution Explorer" }]
    },
    "viewsWelcome": [
      {
        "view": "vsprojSolution",
        "contents": "No solution (.slnx or .sln) found in this folder.\n[New Console App](command:vsproj.newProject)\n[Open Folder](command:vscode.openFolder)",
        "when": "!vsproj.hasSolution"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "vsproj.run", "when": "vsproj.hasSolution && resourceExtname =~ /^\\.(cpp|c|cc|cxx|h|hpp|hh|hxx)$/", "group": "navigation@1" },
        { "command": "vsproj.build", "when": "vsproj.hasSolution && resourceExtname =~ /^\\.(cpp|c|cc|cxx|h|hpp|hh|hxx)$/", "group": "navigation@2" }
      ],
      "view/title": [
        { "command": "vsproj.run", "when": "view == vsprojSolution", "group": "navigation@1" },
        { "command": "vsproj.build", "when": "view == vsprojSolution", "group": "navigation@2" },
        { "command": "vsproj.addClass", "when": "view == vsprojSolution", "group": "navigation@3" },
        { "command": "vsproj.refresh", "when": "view == vsprojSolution", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "vsproj.addClass", "when": "view == vsprojSolution && viewItem =~ /^(project|filter)$/", "group": "1_add@1" },
        { "command": "vsproj.addNewItem", "when": "view == vsprojSolution && viewItem =~ /^(project|filter)$/", "group": "1_add@2" },
        { "command": "vsproj.setStartupProject", "when": "view == vsprojSolution && viewItem == project", "group": "2_project@1" },
        { "command": "vsproj.openProjectFile", "when": "view == vsprojSolution && viewItem == project", "group": "2_project@2" },
        { "command": "vsproj.removeItem", "when": "view == vsprojSolution && viewItem == file", "group": "3_remove" }
      ],
      "explorer/context": [
        { "command": "vsproj.runExeInPrefix", "when": "resourceExtname == .exe", "group": "7_modification" },
        { "command": "vsproj.addToProject", "when": "vsproj.hasSolution && resourceExtname =~ /^\\.(cpp|c|cc|cxx|h|hpp|hh|hxx)$/", "group": "7_modification" }
      ]
    },
    "taskDefinitions": [{ "type": "vsproj", "properties": { "label": { "type": "string" } } }],
    "problemMatchers": [
      {
        "name": "vsproj-gcc",
        "owner": "vsproj",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": { "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 }
      }
    ],
    "configuration": {
      "title": "IDE of Doom and Destruction",
      "properties": {
        "vsproj.configuration": { "type": "string", "enum": ["Debug", "Release"], "default": "Debug", "description": "Build configuration used by Build and Run." },
        "vsproj.platform": { "type": "string", "enum": ["x64", "x86"], "default": "x64", "description": "Platform used by Build and Run." },
        "vsproj.runIn": { "type": "string", "enum": ["externalTerminal", "integratedTerminal"], "default": "externalTerminal", "description": "Where Run shows the program: a separate terminal window (your default terminal app), or the editor's own terminal panel." },
        "vsproj.terminal": { "type": "string", "default": "", "description": "Terminal app for external runs, for example konsole or \"alacritty -e\". Empty uses $TERMINAL, then your desktop's terminal, then the first one found." },
        "vsproj.compiler": { "type": "string", "default": "g++", "description": "Compiler used to build and run on this computer." },
        "vsproj.windowsCompiler": { "type": "string", "default": "", "description": "Cross compiler that makes the Windows .exe when packaging. Empty picks x86_64-w64-mingw32-g++ (x64) or i686-w64-mingw32-g++ (x86)." },
        "vsproj.extraFlags": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Extra compiler flags added to every build." },
        "vsproj.solutionFormat": { "type": "string", "enum": ["slnx", "sln"], "default": "slnx", "description": "Solution file format for new projects." },
        "vsproj.submission.name": { "type": "string", "default": "", "description": "Name used in the submission folder names ({name})." },
        "vsproj.submission.sourceFolder": { "type": "string", "default": "Source - {name}", "description": "Name of the source folder. {name} and {project} are replaced." },
        "vsproj.submission.releaseFolder": { "type": "string", "default": "Release - {name}", "description": "Name of the release folder. {name} and {project} are replaced." },
        "vsproj.submission.solutionName": { "type": "string", "default": "", "description": "File name (without extension) for the solution in the source folder. Empty keeps the current name." },
        "vsproj.checkForUpdates": { "type": "boolean", "default": true, "description": "Look for a newer release once a day." }
      }
    },
    "configurationDefaults": {
      "[cpp]": { "editor.tabSize": 4, "editor.insertSpaces": true, "editor.detectIndentation": false },
      "files.eol": "\r\n"
    }
  }
}
